      subroutine userchk
      include 'SIZE'
      include 'ADJOINT'
      include 'AVG'
      include 'CTIMER'
      include 'CVODE'
      include 'DEALIAS'
      include 'DOMAIN'
      include 'DXYZ'
      include 'EIGEN'
      include 'ESOLV'
      include 'FDMH1'
      include 'GEOM'
      include 'GFLDR'
      include 'GMRES'
      include 'HSMG'
      include 'INPUT'
      include 'IXYZ'
      include 'MASS'
      include 'MVGEOM'
      include 'NEKNEK'
      include 'NEKUSE'
      include 'NONCON'
      include 'OPCTR'
      include 'ORTHOP'
      include 'ORTHOSTRS'
      include 'ORTHOT'
      include 'PARALLEL'
      include 'RESTART'
      include 'SCRCT'
      include 'SEMHAT'
      include 'SOLN'  
      include 'STEADY'
      include 'TOPOL'
      include 'TSTEP'
      include 'VPROJ'
      include 'WZ'
      include 'WZF'
      include 'ZPER'
      include 'OBJDATA'
      implicit none

c     PARDICT is a textual (parameter) header, not a module use-stub,
c     so it must come after all 'use' includes and implicit none
      include 'PARDICT'

c     ADD ALL INCLUDE FILES THEN EXIT

      if (nid.eq.0) then
        write(6,*) '-------------------------------------'
        write(6,*) 'All include files added with success.'
        write(6,*) 'Exiting.'
        write(6,*) '-------------------------------------'
      endif

      call exitt

      return
      end
