     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)

 10   format ('ERROR: param ',a12,E15.7)
 11   format ('ERROR: param ',a12,I10)
 12   format ('ERROR: param ',a12,L1)
      
      return
      end
c-----------------------------------------------------------------------
      subroutine read_hrefine_mpiio_file_test(prefix,ifile
     $                                       ,eps4,eps8,ierr)
c     read (mpiio) after h-refine
      include 'SIZE'            !
      include 'INPUT'           ! PARAM, NPSCAL
      include 'TSTEP'           ! ISTEP, PI, IF_FULL_PRES
      include 'RESTART'
      include 'PARALLEL'

c     argument list
      integer ifile,il
      real eps4, eps8, eps_intp

c     local variables
      logical test_pass
      real time_test
      character*132 fstring
      character*5 nstring
      character*10 refstring
      character*3 prefix
      character*14 spec

      eps_intp = 2e-3
      time_test = pi

      call blank(refstring, 10)
      if (nhref.eq.1) then
         ncut = hrefcuts(1)
         if (ncut.eq.2) refstring = ' href=2 '
         if (ncut.eq.3) refstring = ' href=3 '
         if (ncut.eq.4) refstring = ' href=4 '
      elseif (nhref.eq.2) then
         ncut = 4
         refstring = ' href=2;2 '
      Else
         return
      endif

c     mpiio single precision
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of single .f file'
         write(*,*) 'Testing hrefine',refstring
         write(*,*) 'Testing single precision'
         write(*,*) ' '
      endif
      ifile = ifile +1

      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      write(nstring,'(i5.5)') ifile
      if (prefix.eq.'   ') then
         fstring='io_test0.f'//nstring
      else
         fstring=prefix//'io_test0.f'//nstring
      endif
      call fields_clean
      call load_fld(fstring)
      call fields_compare(eps4,eps_intp,test_pass)

c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TTTTTTTTTTTTTF',4,1,0,.false.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)

c     check string restart options
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of single .f file'
         write(*,*) 'Testing hrefine',refstring
         write(*,*) 'Testing restart flags'
         write(*,*) ' '
      endif
      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      write(nstring,'(i5.5)') ifile
      call blank  (initc(1),132)

      if (prefix.eq.'   ') then
         initc(1)='io_test0.f'//nstring//' U S1 TIME=5.0'
      else
         initc(1)=prefix//'io_test0.f'//nstring//' U S1 TIME=5.0'
      endif

      call fields_clean
      call setics
      call fields_compare(eps4,eps_intp,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('FFTTTFTFTTTFTF',4,1,0,.false.,
     $                     5.0,eps8,test_pass)
      call report(test_pass,ierr)

c     mpiio double precision
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of single .f file'
         write(*,*) 'Testing hrefine',refstring
         write(*,*) 'Testing double precision'
         write(*,*) ' '
      endif

      ifile = ifile +1

      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      write(nstring,'(i5.5)') ifile
c     (Plan E fix) prefix branches were inverted here vs the other blocks:
c     blank prefix -> bare name; real prefix -> prefixed name.
      if (prefix.eq.'   ') then
         fstring='io_test0.f'//nstring
      else
         fstring=prefix//'io_test0.f'//nstring
      endif
      call fields_clean
      call load_fld(fstring)
      call fields_compare(eps8,eps_intp,test_pass)
c     check restart header (see chk_restart_hdr). hrefine+double: pressure
c     handling depends on PnPn vs PnPn-2 (do not read pr when PnPn-2 + href +
c     if_full_pres). pos6=ifgetp, pos14=if_full_pres.
      spec = 'TTTTTFTTTTTTTT'          ! PnPn-2: ifgetp=F, if_full_pres=T
      if (ifsplit) spec = 'TTTTTTTTTTTTTF' ! PnPn: ifgetp=T, if_full_pres=F
      call chk_restart_hdr(spec,8,1,0,.false.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)

 10   format ('ERROR: param ',a12,E15.7)
 11   format ('ERROR: param ',a12,I10)
 12   format ('ERROR: param ',a12,L1)

      return
      end
c-----------------------------------------------------------------------
