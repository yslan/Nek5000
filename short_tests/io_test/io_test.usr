c-----------------------------------------------------------------------
c
c     This is small test to perform basic checks of Nek5000's I/O routines
c     Threre are four sets of tests:
c     - reading checkpoint failes for backward compatibility
c       m12io_test0.f00001 - single precision single file
c       m22io_test?.f00001 - single precision two files with nx1=10
c       m22io_test?.f00002 - single precision two files with byte swap
c       m22io_test?.f00003 - double precision two files with byte swap
c       fb2io_test.fld01   - binary .fld file
c       fa2io_test.fld01   - ascii .fld file
c     - writing and reading single .f file using mpiio
c       single precision writing/reading
c       test of the restart flags set in sioflag routine
c       double precision writing/reading testing if_full_pres option
c     - writing and reading multiple .f files
c       single precision writing/reading
c       double precision writing/reading testing if_full_pres option
c     - writing and reading .fld files
c       binary .fld writing/reading
c       ascii .fld writing/reading
c     
c     All test check corresponding restart falggs and calculate L2 norm
c     of the difference between exact and loaded value of given varialbe
c     (coordinates, velocity, temperature and passive scalars).
c
c     Current tests are performed for P_N-P_N-2 only.
c
c-----------------------------------------------------------------------
      subroutine uservp (ix,iy,iz,ieg)
      include 'SIZE'
      include 'NEKUSE'          ! UDIFF, UTRANS

c     argument list
      integer ix, iy, iz, ieg

      udiff =0.
      utrans=0.

      return
      end
c-----------------------------------------------------------------------
      subroutine userf  (ix,iy,iz,ieg)
      include 'SIZE'
      include 'NEKUSE'          ! FF[XYZ]

c     argument list
      integer ix,iy,iz,ieg
      
      ffx = 0.0
      ffy = 0.0
      ffz = 0.0
      
      return
      end
c-----------------------------------------------------------------------
      subroutine userq  (ix,iy,iz,ieg)
      include 'SIZE'
      include 'NEKUSE'          ! QVOL

c     argument list
      integer ix,iy,iz,ieg
      
      qvol   = 0.0

      return
      end
c-----------------------------------------------------------------------
c     Report one sub-test's pass/fail (rank 0 only) and accumulate ierr.
c     The bare 'PASSED'/'FAILED' tokens are load-bearing: NekTests.py detects
c     success by the presence of 'All I/O tests PASSED' (written by userchk),
c     and this ierr drives that. Keep the output text byte-identical.
      subroutine report(test_pass,ierr)
      include 'SIZE'
      include 'PARALLEL'        ! nid
      logical test_pass
      integer ierr

      if (nid.ne.0) return
      write(*,*) ' '
      if (test_pass) then
         write(*,*) 'PASSED'
      else
         write(*,*) 'FAILED'
         ierr = ierr + 1
      endif
      write(*,*) ' '

      return
      end
c-----------------------------------------------------------------------
c     Verify the restart-header state after a load (rank 0 only). Replaces the
c     17 near-identical "check reading options" blocks. Sets test_pass=.false.
c     and prints an 'ERROR: param ...' line on each mismatch (byte-identical to
c     the old inline checks). All checks are individually skippable.
c
c     spec   : character*14, one char per restart flag, in this order:
c              1 ifgtim   2 ifgetx   3 ifgetxr  4 ifgetu   5 ifgetur
c              6 ifgetp   7 ifgetpr  8 ifgett   9 ifgettr 10 ifgtps(1)
c             11 ifgtpsr(1) 12 ifgtps(2) 13 ifgtpsr(2) 14 if_full_pres
c              'T' expect .true., 'F' expect .false., '.' skip.
c     wdexp  : expected wdsizr (4 or 8); 0 = skip.
c     nfmode : 0 skip; 1 expect nfiler==np; 2 expect nfiler==2.
c     bswexp : -1 skip; 0 expect if_byte_sw .false.; 1 expect .true.
c     nelchk : .true. -> check nelgr==nelgt.
c     texp,teps : if teps>0 check abs(time-texp)<=teps; teps<0 skip.
      subroutine chk_restart_hdr(spec,wdexp,nfmode,bswexp,nelchk,
     $                           texp,teps,test_pass)
      include 'SIZE'
      include 'INPUT'           ! if_full_pres is in TSTEP; ifget* in RESTART
      include 'TSTEP'           ! if_full_pres, time
      include 'RESTART'         ! ifget*, ifgtps*, wdsizr, nfiler, nelgr, ..
      include 'PARALLEL'        ! nid, np, nelgt
      character*14 spec
      integer wdexp,nfmode,bswexp
      logical nelchk,test_pass
      real texp,teps

      logical fval(14)
      character*12 lbl(14)
      integer i
      save lbl
      data lbl /'ifgtim    : ','ifgetx    : ','ifgetxr   : ',
     $          'ifgetu    : ','ifgetur   : ','ifgetp    : ',
     $          'ifgetpr   : ','ifgett    : ','ifgettr   : ',
     $          'ifgtps1   : ','ifgtpsr1  : ','ifgtps2   : ',
     $          'ifgtpsr2  : ','if_full_pres'/

      if (nid.ne.0) return

      if (teps.gt.0.0) then
         if (abs(time-texp).gt.teps) then
            test_pass = .false.
            write(*,10) 'time      : ',time
         endif
      endif
      if (nfmode.eq.1 .and. nfiler.ne.np) then
         test_pass = .false.
         write(*,11) 'nfiler    : ',nfiler
      endif
      if (nfmode.eq.2 .and. nfiler.ne.2) then
         test_pass = .false.
         write(*,11) 'nfiler    : ',nfiler
      endif
      if (nelchk .and. nelgr.ne.nelgt) then
         test_pass = .false.
         write(*,11) 'nelgr     : ',nelgt
      endif
      if (wdexp.ne.0 .and. wdsizr.ne.wdexp) then
         test_pass = .false.
         write(*,11) 'wdsizr    : ',wdsizr
      endif
      if (bswexp.eq.0 .and. if_byte_sw) then
         test_pass = .false.
         write(*,12) 'if_byte_sw: ',if_byte_sw
      endif
      if (bswexp.eq.1 .and. .not.if_byte_sw) then
         test_pass = .false.
         write(*,12) 'if_byte_sw: ',if_byte_sw
      endif

      fval(1)  = ifgtim
      fval(2)  = ifgetx
      fval(3)  = ifgetxr
      fval(4)  = ifgetu
      fval(5)  = ifgetur
      fval(6)  = ifgetp
      fval(7)  = ifgetpr
      fval(8)  = ifgett
      fval(9)  = ifgettr
      fval(10) = ifgtps(1)
      fval(11) = ifgtpsr(1)
      fval(12) = ifgtps(2)
      fval(13) = ifgtpsr(2)
      fval(14) = if_full_pres
      do i = 1,14
         if (spec(i:i).eq.'T' .and. .not.fval(i)) then
            test_pass = .false.
            write(*,12) lbl(i),fval(i)
         elseif (spec(i:i).eq.'F' .and. fval(i)) then
            test_pass = .false.
            write(*,12) lbl(i),fval(i)
         endif
      enddo

   10 format ('ERROR: param ',a12,E15.7)
   11 format ('ERROR: param ',a12,I10)
   12 format ('ERROR: param ',a12,L1)
      return
      end
c-----------------------------------------------------------------------
c     Restore the reference fields and write a checkpoint (the common write
c     prologue used by every write/read sub-test). Sets the write params, the
c     full-pressure flag, and the solution time, then calls prepost.
c       iprec  : 0 single precision (wdsize 4), 1 double (wdsize 8)  -> param(63)
c       nfiles : number of output files                             -> param(65)
c       ifmt   : file format code (6=.f mpiio, 4=bin .fld, -4=ascii) -> param(66)
c       ffp    : if_full_pres (PnPn full-pressure write)
c       prefix : 3-char output-file prefix ('   ' for none)
      subroutine run_write(iprec,nfiles,ifmt,ffp,prefix)
      include 'SIZE'
      include 'INPUT'           ! param
      include 'TSTEP'           ! pi, if_full_pres, time
      integer iprec,nfiles,ifmt
      logical ffp
      character*3 prefix

      if_full_pres = ffp
      param(63) = float(iprec)
      param(65) = float(nfiles)
      param(66) = float(ifmt)
      time = pi
      call fields_restore
      call prepost(.true.,prefix)

      return
      end
c-----------------------------------------------------------------------
      subroutine userchk
      include 'SIZE'
      include 'INPUT'           ! PARAM, NPSCAL
      include 'TSTEP'           ! ISTEP
      include 'RESTART'
      include 'PARALLEL'
      include 'GEOM'            ! IFVCOR

c     local variables
      integer ifile
      real eps4, eps8, eps_map,time_test
      parameter (eps4=1.0E-06,eps8=1.0E-12,eps_map=5.0E-04)
      character*132 fstring
      character*5 nstring
      logical valid_hr

      time_test = pi
      ifvcor = .false.
      call fields_init
      ierr = 0

c     PR #900 acceptance: high-order FP64 checkpoint. Gated by uparam(3):
c       1 -> WRITE an FP64 single-file checkpoint at this build's order
c       2 -> READ 'hio' checkpoint back (interp to this build's lx1); assert
c     Run 1 builds at high order (nxr large), run 2 at lx1=6 so the per-element
c     payload nxyzr=ldim*nxr^3*2 exceeds the old per-element cap.
      if (int(uparam(3)).ge.1) then
         call hio_highorder_test(int(uparam(3)),eps4,eps_map,ierr)
         if (NIO.eq.0) then
            write(*,*) ' '
            if (ierr.eq.0) then
               write(*,*) 'All I/O tests PASSED'
            else
               write(*,*) 'Some I/O test FAILED'
            endif
         endif
         call exitt
      endif

      if (nhref.gt.0) then ! read-only for h-refine
         valid_hr = .false.
         if (nhref.eq.1) then
           if (hrefcuts(1).ge.2.AND.hrefcuts(1).le.4) valid_hr = .true.
         elseif (nhref.eq.2) then
           if (hrefcuts(1).eq.2.AND.hrefcuts(2).eq.2) valid_hr = .true.
         endif
         if (.not.valid_hr) then
           if (nio.eq.0) write(*,*)'href schedule is not in tests'
           call exitt
         endif

         ! read fld from orig re2
         ifile = 0
         call read_hrefine_mpiio_file_test('   ',ifile,eps4,eps8,ierr)

         ! read fld from prev hrefine
         if (nhref.eq.2) then
           ifile = 0
           call read_hrefine_mpiio_file_test('hr2',ifile,eps4,eps8,ierr)
         endif

         ! write/read test and write fld for future hrefine tests
         if (nhref.eq.1.AND.hrefcuts(1).eq.2) then
           ifile = 0
           call write_read_mpiio_file_test('hr2',ifile,eps4,eps8,ierr)
         endif

      else ! normal runs
         call read_old_file_test(eps4,eps8,eps_map,ierr)

         ifile = 0
         call write_read_mpiio_file_test('   ',ifile,eps4,eps8,ierr)

         if (mod(NP,2).eq.0) then
            call write_read_multipe_file_test(ifile,eps4,eps8,ierr)
         endif

         ifile = 0
         call write_read_fld_file_test(ifile,eps4,eps8,ierr)

         call read_gfldr_test(eps4,eps8,eps_map,ierr)

      endif


      if (NIO.eq.0) then
         write(*,*) ' '
         if (ierr.eq.0) then
            write(*,*) 'All I/O tests PASSED'
         else
            write(*,*) 'Some I/O test FAILED'
         endif
         write(*,*) ' '
      endif

      call exitt

      return
      end
c-----------------------------------------------------------------------
      subroutine userbc (ix,iy,iz,iside,ieg)

      include 'SIZE'
      include 'NEKUSE'          ! UX, UY, UZ, TEMP, X, Y

c     argument list
      integer ix,iy,iz,iside,ieg

c     velocity
      UX = 0.0
      UY = 0.0
      UZ = 0.0

c     temperature
      TEMP = 0.0

      return
      end
c-----------------------------------------------------------------------
      subroutine useric (ix,iy,iz,ieg)

      include 'SIZE'
      include 'NEKUSE'          ! UX, UY, UZ, TEMP, Z
      include 'INPUT'           ! IF3D, IFLDMHD
      include 'TSTEP'           ! PI, IFIELD

c     argument list
      integer ix, iy, iz, ieg

c     it is small mesh with cylindrical hole in the middle
      if (ifield.eq.1) then
         ux = sin(r*pi)*cos(2.0*theta)
         uy = cos(r*pi)*sin(4.0*theta)
         uz = 0.0
         if (IF3D) then
            ux = ux*sin(z*pi)
            uy = uy*cos(z*pi)
            uz = z*z*sin(x*pi)*cos(3.0*y*pi)
         endif
      elseif (ifield.ne.ifldmhd) then
         temp = r*cos(ifield*theta)
      endif
      
      
      return
      end
c-----------------------------------------------------------------------
c     This routine to modify element vertices
      subroutine usrdat
      include 'SIZE'
      include 'INPUT'          ! ifcrrs, nrst_rd, nrst_cm, uparam

c     Restart redistribution path toggle for I/O tests:
c       uparam(2) = 0 (default) -> crystal router (ifcrrs=.true.)
c       uparam(2) = 1           -> MPI-RMA one-sided (ifcrrs=.false.)
      if (int(uparam(2)).eq.1) ifcrrs = .false.

c     Bounded-round CR stress (multi-batch + multi-round) for the CI:
c       uparam(6) > 0 -> nrst_rd = uparam(6)  (small read batch -> many batches)
c       uparam(7) > 0 -> nrst_cm  = uparam(7)  (small recv cap  -> >1 round/batch)
      if (int(uparam(6)).gt.0) nrst_rd = int(uparam(6))
      if (int(uparam(7)).gt.0) nrst_cm  = int(uparam(7))

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat2
      include 'SIZE'

      return
      end
c-----------------------------------------------------------------------
      subroutine usrdat3
      return
      end
c-----------------------------------------------------------------------
c     routine to initilise arrays for future comparison
      subroutine fields_init

      include 'SIZE'
      include 'INPUT'
      include 'TSTEP'
      include 'GEOM'
      include 'SOLN'

c     local variables
      integer il, jl, kl, ll, nn
      include 'REFDATA'         ! /REFDATA/ reference-field cache

!     start from setting value for pressure
      do il=1,nelv
      do jl=1,nz2
      do kl=1,ny2
      do ll=1,nx2
         pr(ll,kl,jl,il)=xm2(ll,kl,jl,il)*ym2(ll,kl,jl,il)
         if (IF3D) pr(ll,kl,jl,il) =
     $             pr(ll,kl,jl,il)*zm2(ll,kl,jl,il)
      enddo
      enddo
      enddo
      enddo

      nn =nx1*ny1*nz1*nelt
      call copy(cmp_x(1,1),xm1,nn)
      call copy(cmp_x(1,2),ym1,nn)
      if (IF3D) call copy(cmp_x(1,ndim),zm1,nn)
      
      nn =nx1*ny1*nz1*nelv
      call copy(cmp_v(1,1),vx,nn)
      call copy(cmp_v(1,2),vy,nn)
      if (IF3D) call copy(cmp_v(1,ndim),vz,nn)

      nn =nx2*ny2*nz2*nelv
      call copy(cmp_pr,pr,nn)

      do il = 1 , 1 + npscal
         nn =nx1*ny1*nz1*nelfld(il+1)
         call copy(cmp_t(1,il),t(1,1,1,1,il),nn)
      enddo

      return
      end
c-----------------------------------------------------------------------
c     routine to clean fields in SOLN arrays
      subroutine fields_clean

      include 'SIZE'
      include 'INPUT'
      include 'TSTEP'
      include 'GEOM'
      include 'SOLN'

c     local variables
      integer il, nn

      nn =nx1*ny1*nz1*nelv
      call rzero(vx,nn)
      call rzero(vy,nn)
      if (IF3D) call rzero(vz,nn)

      nn =nx2*ny2*nz2*nelv
      call rzero(pr,nn)

      do il = 1 , 1 + npscal
         nn =nx1*ny1*nz1*nelfld(il+1)
         call rzero(t(1,1,1,1,il),nn)
      enddo

      return
      end
c-----------------------------------------------------------------------
c     routine to restore fields in SOLN arrays
      subroutine fields_restore

      include 'SIZE'
      include 'INPUT'
      include 'TSTEP'
      include 'GEOM'
      include 'SOLN'

c     local variables
      integer il, nn
      include 'REFDATA'         ! /REFDATA/ reference-field cache
      
      nn =nx1*ny1*nz1*nelt
      call copy(xm1,cmp_x(1,1),nn)
      call copy(ym1,cmp_x(1,2),nn)
      if (IF3D) call copy(zm1,cmp_x(1,ndim),nn)
      
      nn =nx1*ny1*nz1*nelv
      call copy(vx,cmp_v(1,1),nn)
      call copy(vy,cmp_v(1,2),nn)
      if (IF3D) call copy(vz,cmp_v(1,ndim),nn)

      nn =nx2*ny2*nz2*nelv
      call copy(pr,cmp_pr,nn)

      do il = 1 , 1 + npscal
         nn =nx1*ny1*nz1*nelfld(il+1)
         call copy(t(1,1,1,1,il),cmp_t(1,il),nn)
      enddo

      return
      end
c-----------------------------------------------------------------------
c     PR #900 acceptance: high-order FP64 checkpoint write/read.
c     mode=1: write an FP64 single .f checkpoint ('hio' prefix) at this
c             build's order (run at high lx1 so nxr is large).
c     mode=2: read 'hio' checkpoint back into this build (run at lx1=6) and
c             compare against the analytic fields; interp tolerance eps_map.
c     When the read build's lx1 < write order and wdsizr=8, the per-element
c     payload nxyzr = ldim*nxr^3*2 exceeds the old crystal-router per-element
c     cap (now lifted to lrst_elem).
      subroutine hio_highorder_test(mode,eps4,eps_map,ierr)
      include 'SIZE'
      include 'INPUT'           ! PARAM
      include 'TSTEP'           ! PI, IF_FULL_PRES
      include 'RESTART'
      include 'PARALLEL'

      integer mode,ierr
      real eps4,eps_map
      logical test_pass
      character*132 fstring

      test_pass = .true.

      if (mode.eq.1) then
c        WRITE FP64 checkpoint at this build's (high) order
         if (NIO.eq.0) write(*,*) 'hio: write FP64 hi-order'
         call run_write(1,1,6,.false.,'hio') ! double prec, 1 file, .f

      else
c        READ it back into this (lx1=6) build; interp from high order
         if (NIO.eq.0) write(*,*) 'hio: read FP64 hi-order'
         param(67) = 6.0
         time = 0.0
         fstring='hioio_test0.f00001 '
         call load_fld(fstring)
         call fields_compare(eps_map,eps_map,test_pass)
         if (NID.eq.0) then
            if (wdsizr.ne.8) then
               test_pass = .false.
               write(*,*) 'hio: expected wdsizr=8, got ',wdsizr
            endif
         endif
         if (.not.test_pass) ierr = ierr + 1
      endif

      return
      end
c-----------------------------------------------------------------------
c     compare fields and wite out L2 norms
c     I compare only the fileds present in the file
      subroutine fields_compare(epsx,epsu,test_pass)

      include 'SIZE'
      include 'INPUT'
      include 'TSTEP'
      include 'SOLN'
      include 'GEOM'
      include 'RESTART'

c     argument list
      real epsx, epsu
      
c     local variables
      integer il, nn
      real l2rdiff
      real rdiff(lx1*ly1*lz1*lelt)
      common /CTMP0/ rdiff
      character*7 fieldname
      character*2 snum

      logical test_pass
      
      include 'REFDATA'         ! /REFDATA/ reference-field cache

c     functions
      real gl2norm, gl2norm2

      if (ifgetxr.and.ifgetx) then
         nn =nx1*ny1*nz1*nelt
         
         call sub3(rdiff,cmp_x(1,1),xm1,nn)
         l2rdiff = gl2norm(rdiff,nn)
         if (l2rdiff.gt.epsx) then
            test_pass = .false.
            if (nio.eq.0) write(*,10) 'coord x',l2rdiff
         else
            if (nio.eq.0) write(*,11) 'coord x',l2rdiff
         endif
         
         call sub3(rdiff,cmp_x(1,2),ym1,nn)
         l2rdiff = gl2norm(rdiff,nn)
         if (l2rdiff.gt.epsx) then
            test_pass = .false.
            if (nio.eq.0) write(*,10) 'coord y',l2rdiff
         else
            if (nio.eq.0) write(*,11) 'coord y',l2rdiff
         endif

         if (IF3D) then
            call sub3(rdiff,cmp_x(1,ndim),zm1,nn)
            l2rdiff = gl2norm(rdiff,nn)
            if (l2rdiff.gt.epsx) then
               test_pass = .false.
               if (nio.eq.0) write(*,10) 'coord z',l2rdiff
            else
               if (nio.eq.0) write(*,11) 'coord z',l2rdiff
            endif
         endif
      endif

      if (ifgetur.and.ifgetu) then
         nn =nx1*ny1*nz1*nelv
         
         call sub3(rdiff,cmp_v(1,1),vx,nn)
         l2rdiff = gl2norm(rdiff,nn)
         if (l2rdiff.gt.epsu) then
            test_pass = .false.
            if (nio.eq.0) write(*,10) 'vel x  ',l2rdiff
         else
            if (nio.eq.0) write(*,11) 'vel x  ',l2rdiff
         endif
         
         call sub3(rdiff,cmp_v(1,2),vy,nn)
         l2rdiff = gl2norm(rdiff,nn)
         if (l2rdiff.gt.epsu) then
            test_pass = .false.
            if (nio.eq.0) write(*,10) 'vel y  ',l2rdiff
         else
            if (nio.eq.0) write(*,11) 'vel y  ',l2rdiff
         endif

         if (IF3D) then
            call sub3(rdiff,cmp_v(1,ndim),vz,nn)
            l2rdiff = gl2norm(rdiff,nn)
            if (l2rdiff.gt.epsu) then
               test_pass = .false.
               if (nio.eq.0) write(*,10) 'vel z  ',l2rdiff
            else
               if (nio.eq.0) write(*,11) 'vel z  ',l2rdiff
            endif
         endif
      endif

      if (ifgetpr.and.ifgetp) then
         nn =nx2*ny2*nz2*nelv
         call sub3(rdiff,cmp_pr,pr,nn)
         l2rdiff = gl2norm2(rdiff,nn)
         if (l2rdiff.gt.epsu) then
            test_pass = .false.
            if (nio.eq.0) write(*,10) 'pres   ',l2rdiff
         else
            if (nio.eq.0) write(*,11) 'pres   ',l2rdiff
         endif
      endif

      if (ifgettr.and.ifgett) then
         nn =nx1*ny1*nz1*nelt
         
         call sub3(rdiff,cmp_t,t,nn)
         l2rdiff = gl2norm(rdiff,nn)
         if (l2rdiff.gt.epsu) then
            test_pass = .false.
            if (nio.eq.0) write(*,10) 'temp   ',l2rdiff
         else
            if (nio.eq.0) write(*,11) 'temp   ',l2rdiff
         endif
      endif

      do il=2, 1+ npscal
         if(ifgtpsr(il-1).and.ifgtps(il-1)) then
            nn =nx1*ny1*nz1*nelfld(il+1)
            
            call sub3(rdiff,cmp_t(1,il),t(1,1,1,1,il),nn)
            l2rdiff = gl2norm(rdiff,nn)
            if (l2rdiff.gt.epsu) then
               test_pass = .false.
               write(snum,'(i2.2)') il-1
               fieldname = 'psc'//snum//'  '
               if (nio.eq.0) write(*,10) fieldname,l2rdiff
            else
               write(snum,'(i2.2)') il-1
               fieldname = 'psc'//snum//'  '
               if (nio.eq.0) write(*,11) fieldname,l2rdiff
            endif 
         endif
      enddo

 10   format ('ERROR: field ',a7,' diff l2 norm = ',E15.7)
 11   format ('PASSED:field ',a7,' diff l2 norm = ',E15.7)

      return
      end
c-----------------------------------------------------------------------
c     Reading tests (old fiels for backwadr compatibility)
      subroutine read_old_file_test(eps4,eps8,eps_map,ierr)
      include 'SIZE'            !
      include 'INPUT'           ! PARAM, NPSCAL
      include 'TSTEP'           ! ISTEP, PI, IF_FULL_PRES
      include 'RESTART'
      include 'PARALLEL'

c     argument list
      real eps4,eps8,eps_map
      
c     local variables
      logical test_pass
      real time_test
      character*132 fstring
      
      time_test = pi

      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of single .f file'
         write(*,*) ' '
      endif
      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      fstring='m12io_test0.f00001 '
      call load_fld(fstring)
      call fields_compare(eps4,eps4,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TTTTTTTTTTTTTF',4,1,0,.true.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)

c     multiple files
      test_pass = .true.
      if (mod(NP,2).eq.0) then
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of multiple .f files'
         write(*,*) 'Testing interpolation form nx1=10 to nx1=6'
         write(*,*) ' '
      endif
      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      fstring='m22io_test?.f00001 '
      call load_fld(fstring)
      call fields_compare(eps_map,eps_map,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TTTTTTTTTTTTTF',4,2,0,.true.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)

c     multiple file single precision with byte swap
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of multiple .f files'
         write(*,*) 'Testing single precision with byte swap'
         write(*,*) ' '
      endif

      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      fstring ='m22io_test?.f00002'
      call load_fld(fstring)
      call fields_compare(eps4,eps4,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TTTTTTTTTTTTTF',4,2,1,.true.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)

c     multiple files double precision with byte swap
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of multiple .f files'
         write(*,*) 'Testing double precision with byte swap'
         write(*,*) ' '
      endif

      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      fstring ='m22io_test?.f00003'
      call load_fld(fstring)
      call fields_compare(eps8,eps8,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TTTTTTTTTTTTTF',8,2,1,.true.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)
      endif
      
c     fld binary
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of .fld binary file'
         write(*,*) ' '
      endif
      if_full_pres = .false.    ! pressure writing format
      param(67) = 4.0           ! file format
      time = 0.0
      fstring='fb2io_test.fld01 '
      call load_fld(fstring)
      call fields_compare(eps4,eps4,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TT.T.T.T.T.T.F',0,0,-1,.false.,
     $                     time_test,eps4,test_pass)
      call report(test_pass,ierr)

c     fld ASCII
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of .fld ASCII file'
         write(*,*) ' '
      endif
      if_full_pres = .false.    ! pressure writing format
      param(67) = -4.0          ! file format
      time = 0.0
      fstring='fa2io_test.fld01 '
      call load_fld(fstring)
      call fields_compare(eps4,eps4,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TT.T.T.T.T.T.F',0,0,-1,.false.,
     $                     time_test,eps4,test_pass)
      call report(test_pass,ierr)

 10   format ('ERROR: param ',a12,E15.7)
 11   format ('ERROR: param ',a12,I10)
 12   format ('ERROR: param ',a12,L1)
      
      return
      end
c-----------------------------------------------------------------------
c     Writing and reading tests for mpiio
      subroutine write_read_mpiio_file_test(prefix,ifile,eps4,eps8,ierr)
      include 'SIZE'            !
      include 'INPUT'           ! PARAM, NPSCAL
      include 'TSTEP'           ! ISTEP, PI, IF_FULL_PRES
      include 'RESTART'
      include 'PARALLEL'

c     argument list
      integer ifile,il
      real eps4, eps8

c     local variables
      logical test_pass
      real time_test
      character*132 fstring
      character*5 nstring
      character*3 prefix
      
      time_test = pi
      
c     mpiio single precision
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing writing/reading of single .f file'
         write(*,*) 'Testing single precision'
         write(*,*) ' '
      endif
      call run_write(0,1,6,.false.,prefix)   ! single prec, 1 file, .f
      ifile = ifile +1

      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      write(nstring,'(i5.5)') ifile
      fstring=prefix//'io_test0.f'//nstring
      call load_fld(fstring)
      call fields_compare(eps4,eps4,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TTTTTTTTTTTTTF',4,1,0,.true.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)

c     check string restart options
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing reading of single .f file'
         write(*,*) 'Testing restart flags'
         write(*,*) ' '
      endif
      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      write(nstring,'(i5.5)') ifile
      call blank  (initc(1),132)
      if (prefix.eq.'   ') then
         initc(1)='io_test0.f'//nstring//' U S1 TIME=5.0'
      else
         initc(1)=prefix//'io_test0.f'//nstring//' U S1 TIME=5.0'
      endif
      call setics
      call fields_compare(eps4,eps4,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('FFTTTFTFTTTFTF',4,1,0,.true.,
     $                     5.0,eps8,test_pass)
      call report(test_pass,ierr)
      
c     mpiio double precision
      test_pass = .true.
      if (NIO.eq.0) then
         write(*,*) ' '
         write(*,*) 'Testing writing/reading of single .f file'
         write(*,*) 'Testing double precision'
         write(*,*) ' '
      endif
      call run_write(1,1,6,.true.,prefix)    ! double prec, 1 file, .f, ffp
      ifile = ifile +1

      if_full_pres = .false.    ! pressure writing format
      param(67) = 6.0           ! file format
      time = 0.0
      write(nstring,'(i5.5)') ifile

      if (prefix.eq.'   ') then
         fstring='io_test0.f'//nstring
      else
         fstring=prefix//'io_test0.f'//nstring
      endif
      call load_fld(fstring)
      call fields_compare(eps8,eps8,test_pass)
c     check restart header (see chk_restart_hdr)
      call chk_restart_hdr('TTTTTTTTTTTTTT',8,1,0,.true.,
     $                     time_test,eps8,test_pass)
      call report(test_pass,ierr)
      
 10   format ('ERROR: param ',a12,E15.7)
 11   format ('ERROR: param ',a12,I10)
 12   format ('ERROR: param ',a12,L1)
      
      return
      end
c-----------------------------------------------------------------------
c     Writing and reading tests for multiple files
      subroutine write_read_multipe_file_test(ifile,eps4,eps8,ierr)
      include 'SIZE'            ! 
      include 'INPUT'           ! PARAM, NPSCAL
      include 'TSTEP'           ! ISTEP, PI, IF_FULL_PRES
