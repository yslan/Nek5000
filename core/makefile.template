SMOD = $(OBJDIR)/size_mod.o
FMOD = $(MODFLAG)

L0 = $(G) -O0
L2 = $(G) -O2
L3 = $(G) -O3

FL0   = $(L0) $(FFLAGS) $(PPS_F) -I$S/core $(INCLUDES) -I$(MODDIR)
FL2   = $(L2) $(FFLAGS) $(PPS_F) -I$S/core $(INCLUDES) -I$(MODDIR)
FL3   = $(L3) $(FFLAGS) $(PPS_F) -I$S/core $(INCLUDES) -I$(MODDIR)

cFL0   = $(L0) $(CFLAGS) $(PPS_C) -I$S/core $(INCLUDES)
cFL2   = $(L2) $(CFLAGS) $(PPS_C) -I$S/core $(INCLUDES)
cFL3   = $(L3) $(CFLAGS) $(PPS_C) -I$S/core $(INCLUDES)

################################################################################
all : nek5000

usr: $(USRF)

$(USRF): ./SIZE.usr ${CASENAME}.usr $(SMOD) $(MODS)
	@env CASENAME=$(CASENAME) PPS="$(PPS)" $S/core/mkuserfile
	$(FC) -c $(FL2) $(VISITNEK_INCLUDES) -I$(CASEDIR) $(CASEDIR)/${CASENAME}.f -o $(USRF)

nek5000: ${LIB} $(USRF) 
	$(FC) -c $(FL2) $S/core/drive.f
	$(LD) $(FL2) -o ${BINNAME} drive.o $(USRF) ${LIB} $(USR_LFLAGS) $(LDFLAGS)
	@if test -f ${BINNAME}; then \
        echo ""; \
        if [ -s $(OBJDIR)/.nekwarn ]; then cat $(OBJDIR)/.nekwarn; echo ""; fi; \
	echo "#############################################################"; \
	echo "#                  Compilation successful!                  #"; \
	echo "#############################################################"; \
	size ${BINNAME}; \
	echo ""; \
	else \
	echo -e "ERROR: Cannot find ${BINNAME}!"; \
	echo -e ""; \
	fi
	@rm -f $(CASEDIR)/${CASENAME}.f drive.o *.i

lib: ${LIB}

mods: ${MODS}

# libtest: link a caller-supplied driver ($(LIBTEST_DRV)) against ONLY the
# library archive + case object + 3rd-party libs to test libnek5000.a is
# self-contained for embedding applications. See NekTests.py::LibLink.
libtest: ${LIB} $(USRF)
	$(FC) -c $(FL2) -I$(CASEDIR) $(LIBTEST_DRV) -o $(OBJDIR)/libtest_drv.o
	$(LD) $(FL2) -o nek_libtest $(OBJDIR)/libtest_drv.o $(USRF) ${LIB} $(USR_LFLAGS) $(LDFLAGS)

${LIB}: $(SMOD) $(MODS) $(NOBJS)
	@$(AR) cr ${LIB} $(SMOD) $(MODS) $(NOBJS)
	@ranlib ${LIB}
	@if test -f ${LIB}; then \
	printf "done\n"; \
	else \
	printf "failed!\n"; \
	echo ""; \
	fi
	@rm -f *.i

clean::
	@rm -rf ${LIB}  ${CASENAME}.f obj ${BINNAME}

.PHONY: all clean lib usr libtest mods

# Ensure every object waits for size_mod and the modules.
$(NOBJS) : $(SMOD) $(MODS)

