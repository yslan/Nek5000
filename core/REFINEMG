c-----------------------------------------------------------------------
c
c  h-refinement
c
c-----------------------------------------------------------------------
      integer*8 hmg_vertex_o((2**ldim)*lelt)
      common /hrefine_i8/ hmg_vertex_o

      integer hmg_nelt_o, hmg_nelv_o
      common /hrefine_i4/ hmg_nelt_o, hmg_nelv_o

c-----------------------------------------------------------------------
c
c  h-mg
c
c-----------------------------------------------------------------------
      integer lxc,lzc,lxyzc,lcut,lblk
      parameter(lxc=2,lzc=(lxc-1)*(ldim-2)+1)            ! crs grid size
      parameter(lxyzc=lxc**ldim)
      parameter(lcut=22)                                 ! max ncut
      parameter(lblk=512)                                ! max nblk

      integer ncut                                       ! refine into ncut segments
     $      , nblk                                       ! =ncut^d
      common /hmg_i/ ncut,nblk

      real hmg_pc(lxc*lxc,lcut)                          ! interp matrix
     $   , hmg_pt(lxc*lxc,lcut)                          ! transpose
      common /hmg_r/ hmg_pc, hmg_pt

      character*3 hmg_cbco(6,lelt)                       ! cbc on orig mesh
      common /hmg_c3/ hmg_cbco

      integer*8 hmg_se_to_gcrs(lxyzc*lelt)               ! glo_num for hmg-crs
      common /hmg_i8/ hmg_se_to_gcrs

      real hmg_crs_cmlt(lxyzc*lelv)                      ! 1/multiplicity for hmg-crs
     $   , hmg_crs_mask(lxyzc*lelv)                      ! mask
      common /hmg_crs_r/ hmg_crs_cmlt, hmg_crs_mask

      integer hmg_crs_gsh                                ! gs handle for crs
      common /hmg_crs_i/ hmg_crs_gsh
